{
  "manifest_version": 3,
  "name": "Claude Gate Web",
  "version": "0.1.0",
  "description": "Checks your public IP before opening claude.ai.",
  "permissions": ["declarativeNetRequest", "storage", "tabs"],
  "host_permissions": ["*://claude.ai/*", "*://www.claude.ai/*", "https://ipapi.co/*", "https://ipwho.is/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html" },
  "web_accessible_resources": [{ "resources": ["gate.html", "gate.js", "gate.css", "fonts/*.woff2"], "matches": ["*://claude.ai/*", "*://www.claude.ai/*"] }]
}
